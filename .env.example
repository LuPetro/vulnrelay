# Localhost API, optional bearer token, and persistent SQLite database.
# Optional Compose isolation: set a distinct project, image and port for a second installation.
# COMPOSE_PROJECT_NAME=vulnrelay-test
# VULNRELAY_IMAGE=vulnrelay-test:local
VULNRELAY_HOST=127.0.0.1
VULNRELAY_PORT=8080
VULNRELAY_DATABASE_URL=sqlite:///./data/vulnrelay.db
VULNRELAY_SYNC_INTERVAL_MINUTES=30
VULNRELAY_LOG_LEVEL=INFO
VULNRELAY_API_TOKEN=
# Optional; no NVD API key is required.
VULNRELAY_NVD_API_KEY=
# Optional OpenCVE Knowledge Base enrichment (no account/API key required).
VULNRELAY_OPENCVE_ENABLED=false
VULNRELAY_OPENCVE_BATCH_SIZE=25
# Telegram connectors reference this variable by name. Never commit real values.
TELEGRAM_BOT_TOKEN=
# Discord and Slack connectors reference webhook URLs by variable name.
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# Optional AI: only the environment variable name is stored in the UI.
VULNRELAY_AI_KEY=
# For an OpenAI-compatible provider, set its API base URL (including /v1 if needed).
VULNRELAY_AI_BASE_URL=
# Explicitly permit private/local AI servers (for example Ollama) only when trusted.
VULNRELAY_AI_ALLOW_PRIVATE_HOSTS=false
# Optional OSV package/version monitoring. Package names and versions are sent to OSV.dev.
VULNRELAY_OSV_ENABLED=false
# Optional SMTP connector: STARTTLS is required. Keep credentials private.
VULNRELAY_SMTP_HOST=
VULNRELAY_SMTP_PORT=587
VULNRELAY_SMTP_USER=
VULNRELAY_SMTP_PASSWORD=
VULNRELAY_SMTP_ALLOW_PRIVATE_HOSTS=false
# Optional generic JSON webhook. The signing key must be kept private.
VULNRELAY_WEBHOOK_URL=
VULNRELAY_WEBHOOK_KEY=
VULNRELAY_WEBHOOK_ALLOW_PRIVATE_HOSTS=false
# Optional push servers: use private topics and keep access tokens secret.
VULNRELAY_NTFY_URL=
VULNRELAY_NTFY_TOKEN=
VULNRELAY_GOTIFY_URL=
VULNRELAY_GOTIFY_TOKEN=
VULNRELAY_PUSH_ALLOW_PRIVATE_HOSTS=false
