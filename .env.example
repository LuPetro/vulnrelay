# Localhost API, optional bearer token, and persistent SQLite database.
VULNRELAY_HOST=127.0.0.1
VULNRELAY_PORT=8080
VULNRELAY_DATABASE_URL=sqlite:///./data/vulnrelay.db
VULNRELAY_SYNC_INTERVAL_MINUTES=30
VULNRELAY_LOG_LEVEL=INFO
VULNRELAY_API_TOKEN=
# Optional; no NVD API key is required.
VULNRELAY_NVD_API_KEY=
# Optional OpenCVE Knowledge Base enrichment (no account/API key required).
VULNRELAY_OPENCVE_ENABLED=false
VULNRELAY_OPENCVE_BATCH_SIZE=25
# Telegram connectors reference this variable by name. Never commit real values.
TELEGRAM_BOT_TOKEN=
